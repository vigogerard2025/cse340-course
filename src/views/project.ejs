<%- include('partials/header') %>
<main>
    <h1><%= project.title %></h1>

    <p><%= project.description %></p>
    <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString('en-US') %></p>
    <p><strong>Location:</strong> <%= project.location %></p>
    <p>
        <strong>Organization:</strong>
        <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
    </p>

    <div>
        <strong>Categories:</strong>
        <% if (categories.length > 0) { %>
            <ul class="tags">
                <% categories.forEach(category => { %>
                    <li><a href="/category/<%= category.category_id %>"><%= category.name %></a></li>
                <% }); %>
            </ul>
        <% } else { %>
            <span>No categories assigned.</span>
        <% } %>
    </div>

    <p><a href="/projects">Back to upcoming projects</a></p>
</main>
<%- include('partials/footer') %>