<%- include('partials/header') %>
<main>
    <h1><%= project.title %></h1>

    <p><%= project.description %></p>
    <p>Organization: <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
    <p>Location: <%= project.location %></p>
    <p>Date: <%= project.date %></p>

    <h2>Categories</h2>
    <% if (categories.length > 0) { %>
        <ul>
            <% categories.forEach(category => { %>
                <li><%= category.name %></li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No categories assigned.</p>
    <% } %>

    <% if (isLoggedIn) { %>
        <h2>Volunteer</h2>
        <% if (isVolunteer) { %>
            <p>You are volunteering for this project.</p>
            <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                <input type="hidden" name="returnTo" value="project">
                <button type="submit" class="link-button">Remove me as a volunteer</button>
            </form>
        <% } else { %>
            <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                <button type="submit" class="link-button">Volunteer for this project</button>
            </form>
        <% } %>
    <% } %>

    <% if (user && user.role_name === 'admin') { %>
        <p>
            <a href="/edit-project/<%= project.project_id %>">Edit Project</a> |
            <a href="/assign-categories/<%= project.project_id %>">Edit Categories</a>
        </p>
    <% } %>
</main>
<%- include('partials/footer') %>